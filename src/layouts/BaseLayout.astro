---
import '../styles/global.css';
import { useTranslations } from '@/i18n/ui';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import BottomAppBar from '@/components/BottomAppBar.astro';
import MermaidRenderer from '@/components/MermaidRenderer.astro';
import { Home, FileText, MessageSquare, UserRound } from 'lucide-react';
import { ClientRouter } from 'astro:transitions';

// Removed language selector imports

type JsonLd = Record<string, unknown>;

type Props = {
  pageTitle: string;
  pageDescription?: string;
  pageImage?: string | { src: string };
  canonicalPath?: string;
  noindex?: boolean;
  openGraphType?: 'article' | 'website';
  structuredData?: JsonLd | Array<JsonLd>;
  usesMermaid?: boolean;
};

export type NavItem = {
  href: string;
  label: string;
  icon: any;
};

const {
  pageTitle,
  pageDescription,
  pageImage,
  canonicalPath,
  noindex = false,
  openGraphType = 'website',
  structuredData,
  usesMermaid = false,
} = Astro.props;
const lang = 'en';
const tSite = useTranslations(lang, 'site');
const tNav = useTranslations(lang, 'nav');
const site = Astro.site ?? new URL('https://loganpeterson.org');
const siteUrl = new URL('/', site).href;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const socialImage = pageImage
  ? new URL(typeof pageImage === 'string' ? pageImage : pageImage.src, site)
      .href
  : undefined;
const title = pageTitle.includes('Logan Peterson')
  ? pageTitle
  : `${pageTitle} | Logan Peterson`;
const personId = `${siteUrl}#logan-peterson`;
const websiteId = `${siteUrl}#website`;
const extraStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Logan Peterson',
      url: siteUrl,
      publisher: { '@id': personId },
      inLanguage: 'en-US',
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Logan Peterson',
      url: siteUrl,
      sameAs: [
        'https://linkedin.loganpeterson.org',
        'https://github.loganpeterson.org',
      ],
      knowsAbout: ['Embedded systems', 'Robotics', 'Electronics'],
    },
    ...extraStructuredData,
  ],
}).replace(/</g, '\\u003c');
const navItems: Array<NavItem> = [
  { href: '/', label: tNav('home'), icon: Home },
  { href: '/about/', label: tNav('about'), icon: UserRound },
  { href: '/blog', label: 'Projects', icon: FileText },
  { href: '/contact', label: tNav('contact'), icon: MessageSquare },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={pageDescription || tSite('description')}
    />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content="Logan Peterson" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={pageDescription || tSite('description')}
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta
      name="twitter:card"
      content={socialImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content={pageDescription || tSite('description')}
    />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={jsonLd} />

    <link rel="icon" href="/favicons/PFP Updated.png" />
    <link rel="shortcut icon" href="/favicons/PFP Updated.png" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicons/PFP Updated.png"
    />
    <link rel="manifest" href="/favicons/light-mode/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <script is:inline>
      const getInitialTheme = () => {
        if (
          typeof sessionStorage !== 'undefined' &&
          sessionStorage.getItem('theme')
        ) {
          return sessionStorage.getItem('theme');
        }
        // Always default to light mode, ignore system preference
        return 'light';
      };
      const theme = getInitialTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      if (typeof sessionStorage !== 'undefined') {
        sessionStorage.setItem('theme', theme);
      }

      document.addEventListener('astro:before-swap', (event) => {
        const storedTheme = sessionStorage.getItem('theme') || 'light';
        event.newDocument.documentElement.classList.toggle(
          'dark',
          storedTheme === 'dark'
        );
      });
    </script>
    <title>{title || tSite('title')}</title>

    {/* Font, for example Google Fonts - to adapt according to your choices */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="h-[100dvh] bg-background font-sans antialiased flex flex-col">
    {/* Tailwind classes for the body */}
    <header class="hidden md:block">
      <!-- passer aussi navItems mais sans le premier element dont le href === '/' -->
      <Header
        navItems={navItems.filter((item) => item.href !== '/') as NavItem[]}
      />
    </header>

    <main
      class="container mx-auto px-4 py-8 flex-1 max-w-screen-2xl pb-20 md:pb-8"
    >
      <slot />
    </main>
    <div class="hidden md:block">
      <Footer />
    </div>
    <BottomAppBar navItems={navItems} />
    {usesMermaid && <MermaidRenderer />}
  </body>
</html>
