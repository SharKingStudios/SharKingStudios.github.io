---
import Heading from '@/components/Heading.astro';
import { FilteredPostsList } from '@/features/blog/components/FilteredPostsList';
import { BlogPostCard } from '@/features/blog';
import type { LanguageCode } from '@/i18n/ui';
import { useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type CollectionEntry as AstroCollectionEntry } from 'astro:content';
import { EmptyState } from '@/components/empty-state';

type Props = {
  posts: AstroCollectionEntry<'blog'>[];
  lang: LanguageCode;
};

const { posts, lang } = Astro.props;
const initialSearchQuery = Astro.url.searchParams.get('q') || '';
const initialTag = Astro.url.searchParams.get('tag') || '';
const texts = useTranslations(lang, 'blogPage');
const componentTexts = {
  searchPlaceholder: texts('searchPlaceholder'),
  filterByTagButtonLabel: texts('filterByTagButtonLabel'),
  noTagFound: texts('noTagFound'),
  selectTagCommandPlaceholder: texts('selectTagCommandPlaceholder'),
  allTagsLabel: texts('allTagsLabel'),
};
const allTags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))]
  .sort()
  .map((tag) => ({
    value: tag,
    label: tag.charAt(0).toUpperCase() + tag.slice(1),
  }));
const pageTitle = texts('pageTitle');
const pageDescription = texts('pageDescription');
---

<BaseLayout {pageTitle} {pageDescription}>
  <div class="container mx-auto px-4 py-8 md:py-12">
    <Heading title={texts('title')} description={texts('description')} />
    <FilteredPostsList
      client:load
      {allTags}
      texts={componentTexts}
      {initialSearchQuery}
      {initialTag}
    />

    <div
      id="blog-posts-container"
      data-blog-filter-root
      class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        posts.length > 0 ? (
          posts.map((postEntry) => (
            <div
              class="blog-post-card-wrapper"
              data-search={`${postEntry.data.title} ${postEntry.data.description ?? ''} ${(postEntry.data.tags ?? []).join(' ')}`}
              data-tags={JSON.stringify(postEntry.data.tags ?? [])}
            >
              <BlogPostCard post={postEntry} lang={lang} />
            </div>
          ))
        ) : (
          <EmptyState
            title={texts('noPostsFound')}
            id="no-posts-initial-message"
            className="hidden"
          />
        )
      }
    </div>
    <EmptyState
      title={texts('noPostsFound')}
      id="no-posts-filtered-message"
      className="hidden"
    />

    <script>
      let cleanupBlogFilters: (() => void) | undefined;

      function setupBlogFilters() {
        cleanupBlogFilters?.();

        const postsContainer = document.querySelector<HTMLElement>(
          '[data-blog-filter-root]'
        );
        const noPostsInitialMessage = document.getElementById(
          'no-posts-initial-message'
        );
        const noPostsFilteredMessage = document.getElementById(
          'no-posts-filtered-message'
        );
        const postCards = Array.from(
          document.querySelectorAll<HTMLElement>('.blog-post-card-wrapper')
        );

        if (!postsContainer || !noPostsFilteredMessage) return;

        const applyFilters = (query = '', tag = '') => {
          const normalizedQuery = query.trim().toLocaleLowerCase();
          const normalizedTag = tag.trim().toLocaleLowerCase();
          let visibleCount = 0;

          postCards.forEach((card) => {
            const searchableText = (
              card.dataset.search ?? ''
            ).toLocaleLowerCase();
            const tags = JSON.parse(card.dataset.tags ?? '[]') as string[];
            const matchesQuery =
              !normalizedQuery || searchableText.includes(normalizedQuery);
            const matchesTag =
              !normalizedTag ||
              tags.some(
                (postTag) => postTag.toLocaleLowerCase() === normalizedTag
              );
            const isVisible = matchesQuery && matchesTag;

            card.classList.toggle('hidden', !isVisible);
            if (isVisible) visibleCount += 1;
          });

          noPostsInitialMessage?.classList.add('hidden');
          postsContainer.classList.toggle('hidden', visibleCount === 0);
          noPostsFilteredMessage.classList.toggle('hidden', visibleCount !== 0);
        };

        const applyFiltersFromUrl = () => {
          const params = new URLSearchParams(window.location.search);
          applyFilters(params.get('q') ?? '', params.get('tag') ?? '');
        };
        const handleFilterChange = (event: Event) => {
          const { query = '', tag = '' } =
            (event as CustomEvent<{ query?: string; tag?: string }>).detail ??
            {};
          applyFilters(query, tag);
        };

        applyFiltersFromUrl();
        window.addEventListener('blog:filters-change', handleFilterChange);
        window.addEventListener('popstate', applyFiltersFromUrl);
        cleanupBlogFilters = () => {
          window.removeEventListener('blog:filters-change', handleFilterChange);
          window.removeEventListener('popstate', applyFiltersFromUrl);
        };
      }

      setupBlogFilters();
      document.addEventListener('astro:page-load', setupBlogFilters);
      document.addEventListener('astro:before-swap', () =>
        cleanupBlogFilters?.()
      );
    </script>
  </div>
</BaseLayout>
