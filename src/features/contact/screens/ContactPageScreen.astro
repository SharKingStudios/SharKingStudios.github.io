---
import Heading from '@/components/Heading.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { FaGithub, FaLinkedin } from 'react-icons/fa';

interface Props {
  mainHeadingTitle: string;
  mainHeadingDescription: string;
  emailTitle: string;
  emailDescription: string;
  emailAddress: string;
  orSeparatorText: string;
  linkedinLabel: string;
  githubLabel: string;
}

const {
  mainHeadingTitle,
  mainHeadingDescription,
  emailTitle,
  emailDescription,
  emailAddress,
  orSeparatorText,
  linkedinLabel,
  githubLabel,
} = Astro.props;
---

<section class="py-12 md:py-16">
  <Heading
    title={mainHeadingTitle}
    description={mainHeadingDescription}
    showDivider={true}
    className="flex flex-col items-center justify-center"
    titleClassName="md:text-5xl"
  />

  <div class="mt-12 flex justify-center">
    <div class="w-full max-w-xl space-y-6">
      <a
        href={`mailto:${emailAddress}`}
        class="block rounded-lg bg-card p-6 shadow transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring md:p-8"
      >
        <span class="text-sm font-medium text-muted-foreground">
          {emailTitle}
        </span>
        <span
          class="mt-2 block break-all text-xl font-semibold text-primary underline-offset-4 hover:underline"
        >
          {emailAddress}
        </span>
        <span class="mt-3 block text-sm text-muted-foreground">
          {emailDescription}
        </span>
      </a>

      <div class="flex items-center" aria-label={orSeparatorText}>
        <hr class="flex-grow border-border" />
        <span class="mx-4 text-sm font-medium text-muted-foreground">
          {orSeparatorText}
        </span>
        <hr class="flex-grow border-border" />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href="https://linkedin.loganpeterson.org"
          class={cn(
            'h-auto w-full py-4 no-underline',
            buttonVariants({ variant: 'outline', size: 'lg' })
          )}
        >
          <FaLinkedin className="size-5" aria-hidden="true" />
          {linkedinLabel}
        </a>
        <a
          href="https://github.loganpeterson.org"
          class={cn(
            'h-auto w-full py-4 no-underline',
            buttonVariants({ variant: 'outline', size: 'lg' })
          )}
        >
          <FaGithub className="size-5" aria-hidden="true" />
          {githubLabel}
        </a>
      </div>
    </div>
  </div>
</section>
