---
import { cn } from '@/lib/utils';
import { Separator } from './ui/separator';

interface Props {
  title: string;
  description?: string;
  className?: string;
  titleClassName?: string;
  descriptionClassName?: string;
  showDivider?: boolean;
  titleHref?: string;
  titleTag?: 'h1' | 'h2' | 'h3';
}

const {
  title,
  description,
  className,
  titleClassName,
  descriptionClassName,
  showDivider = false,
  titleHref,
  titleTag = 'h1',
} = Astro.props;
const HeadingTag = titleTag;
---

<div class={cn('mb-8 space-y-4', className)}>
  <HeadingTag
    class={cn('text-2xl font-bold tracking-tight sm:text-3xl', titleClassName)}
  >
    {
      titleHref ? (
        <a
          href={titleHref}
          class="rounded-sm transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          {title}
        </a>
      ) : (
        title
      )
    }
  </HeadingTag>
  {showDivider && <Separator className="max-w-48 mx-auto" />}
  {
    description ? (
      <p
        class={cn('max-w-3xl text-muted-foreground', descriptionClassName)}
        set:html={description}
      />
    ) : null
  }
</div>
